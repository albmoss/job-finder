# Skopiuj ten plik jako .env i wpisz własne klucze.
# .env jest w .gitignore i nigdy nie trafia do repozytorium.

# Dostawca modelu oceniającego oferty: gemini | openai | anthropic.
# Wystarczy klucz wybranego dostawcy; pozostałe sekcje zostaw puste.
LLM_PROVIDER=gemini

# Kaskada modeli (opcjonalnie): nazwy po przecinku, od pierwszego wyboru.
# Puste = lista domyślna dostawcy (utils/llm.py). Przy limicie albo błędzie
# ocena schodzi na kolejny model z listy.
GEMINI_MODELS=
OPENAI_MODELS=
ANTHROPIC_MODELS=

# Klucz główny + opcjonalne zapasowe do rotacji przy limitach zapytań.
# Bez zapasowych analiza działa, tylko wolniej.

# Gemini. Darmowy klucz: https://aistudio.google.com/apikey
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# OpenAI albo dowolne API zgodne z OpenAI (/chat/completions).
# Inny serwer niż OpenAI: podaj jego adres, np.
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1   (klucz dowolny, np. ollama)
#   LM Studio   http://localhost:1234/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=

# Anthropic Claude: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_1=
ANTHROPIC_API_KEY_2=

# Opcjonalne źródła oparte o API. Puste = źródło jest pomijane.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
CAREERJET_API_KEY=

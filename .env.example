# Skopiuj ten plik jako .env i wpisz własne klucze.
# .env jest w .gitignore i nigdy nie trafia do repozytorium.

# Gemini — wymagany. Darmowy klucz: https://aistudio.google.com/apikey
GEMINI_API_KEY_PRIMARY=

# Opcjonalnie: dodatkowe klucze do rotacji przy limitach zapytań.
# Bez nich analiza działa, tylko wolniej.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Opcjonalne źródła oparte o API. Puste = źródło jest pomijane.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
CAREERJET_API_KEY=

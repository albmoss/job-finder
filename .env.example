# Skopiuj ten plik jako .env i wpisz własne klucze.
# .env jest w .gitignore i nigdy nie trafia do repozytorium.

# Ocena dopasowania ofert do CV: Jev (TypeSafe). Klucz: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Dostawca modelu, który czyta CV: gemini | openai | anthropic.
# Wystarczy klucz wybranego dostawcy; pozostałe sekcje zostaw puste.
LLM_PROVIDER=gemini

# Modele (opcjonalnie): nazwy po przecinku, od pierwszego wyboru.
# Puste = lista domyślna dostawcy (utils/llm.py). Przy limicie albo błędzie
# odczyt CV przechodzi na kolejny model z listy.
GEMINI_MODELS=
OPENAI_MODELS=
ANTHROPIC_MODELS=

# Klucz główny + opcjonalne zapasowe na wypadek limitu zapytań.

# Gemini. Darmowy klucz: https://aistudio.google.com/apikey
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# OpenAI albo dowolne API zgodne z OpenAI (/chat/completions).
# Inny serwer niż OpenAI: podaj jego adres, np.
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1   (klucz dowolny, np. ollama)
#   LM Studio   http://localhost:1234/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_API_KEY_1=
OPENAI_API_KEY_2=

# Anthropic Claude: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_1=
ANTHROPIC_API_KEY_2=

# Opcjonalne źródła oparte o API. Puste = źródło jest pomijane.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
CAREERJET_API_KEY=

# Serwis publiczny (public_server.py). Na serwerze te wartości idą do .env.public
# razem z TYPESAFE_API_KEY i kluczem modelu czytającego CV. Gemini dla użytkowników z UE
# wymaga projektu z aktywnym rozliczeniem (darmowy limit jest niedozwolony).
# Administrator danych i dostawca serwera trafiają do polityki prywatności.
PUBLIC_OPERATOR_NAME=
PUBLIC_OPERATOR_EMAIL=
PUBLIC_HOSTING_PROVIDER=
PUBLIC_ALLOWED_HOSTS=127.0.0.1,localhost
# Jedno darmowe wyszukiwanie na adres IP w tym oknie (dni); adresy właściciela bez limitu.
PUBLIC_FREE_WINDOW_DAYS=30
PUBLIC_UNLIMITED_IPS=
# Bezpiecznik budżetu: wszystkie wyszukiwania w serwisie na dobę.
PUBLIC_DAILY_LIMIT=300
PUBLIC_WORKERS=2
# Cel publish_offers.py: user@host:/katalog/data/offers
PUBLIC_DEPLOY_TARGET=
